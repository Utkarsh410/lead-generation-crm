# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: comma-separated emails allowed to sign in (defense in depth; RLS still applies)
LEADOS_ALLOWED_EMAILS=

# Optional: business timezone used for "today", due dates and reminders (default Asia/Kolkata)
LEADOS_TIMEZONE=Asia/Kolkata

# NEVER add the Supabase service-role key here — LeadOS does not need it.
